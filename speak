#!/usr/bin/env python3
"""Speak text aloud on Jimmy's speakers. Text as arguments, or on stdin.

Wraps the request file that speak-daemon watches. The daemon treats every
request as a TOGGLE - speaking becomes silent, silent becomes speaking - which
is right for a hotkey but wrong for a caller that means "say this now": a bare
write while something is playing would stop it and say nothing. So if audio is
live this stops it first, waits for the daemon to notice, then sends the text.
"""

from __future__ import annotations

import subprocess
import sys
import time
from pathlib import Path

REQUEST = Path("/mnt/c/Users/jimmy/AppData/Local/Temp/speak-request.txt")


def is_busy() -> bool:
    """True while the daemon has a player up.

    Checked via the player process rather than a PulseAudio sink, because the
    process exists during synthesis too - roughly 360ms before a sink appears -
    and a request landing in that window would silently cancel the utterance.

    ``pgrep -x`` matches the process NAME, never the command line. Matching a
    command line means matching this caller's own arguments too, so speaking a
    sentence that happened to mention the player would report a phantom.
    """
    found = subprocess.run(
        ["pgrep", "-x", "ffplay"], capture_output=True, text=True
    ).stdout.split()
    for pid in found:
        state = Path(f"/proc/{pid}/stat")
        if state.exists() and state.read_text().split(") ", 1)[1][0] != "Z":
            return True
    return False


def main() -> None:
    text = " ".join(sys.argv[1:]).strip() or sys.stdin.read().strip()
    if not text:
        sys.exit("nothing to speak")
    if is_busy():
        REQUEST.write_text("stop", encoding="utf-8")
        time.sleep(0.2)
    REQUEST.write_text(text, encoding="utf-8")


if __name__ == "__main__":
    main()
